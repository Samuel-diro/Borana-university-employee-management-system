{
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.associations": {
    "*.php": "php",
    "*.sql": "sql",
    "*.css": "css",
    "*.js": "javascript"
  },
  "php.suggest.basic": true,
  "php.validate.enable": true,
  "php.validate.run": "onType",
  "html.format.enable": true,
  "css.validate": true
}
