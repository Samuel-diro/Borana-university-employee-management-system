{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug (XAMPP)",
      "type": "php",
      "request": "launch",
      "port": 9003
    },
    {
      "name": "Launch Built-in PHP Server",
      "type": "php",
      "request": "launch",
      "program": "${workspaceRoot}/index.php",
      "serverReadyAction": {
        "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
